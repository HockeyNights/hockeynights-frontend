{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "testid:registry": "node ../scripts/generate-testid-reference.mjs",
    "preview": "vite preview",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.21.0",
    "@gravity-ui/uikit": "^7.47.2",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.101.4",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lottie-react": "^2.4.1",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "brace-expansion": "file:vendor/brace-expansion",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.5.0",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "brace-expansion": "$brace-expansion"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
